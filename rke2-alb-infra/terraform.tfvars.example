# ==============================================================================
# RKE2 ALB to Worker Nodes - Environment Variables Template
# ==============================================================================

aws_region      = "us-east-1"
name            = "rke2-ingress"
vpc_id          = "vpc-04069dd8bf42ea2db"
domain_name     = "alpfrtech.com"
app_subdomain   = "rke2" # Use "rke2" (rke2.alpfrtech.com) or "app" to replace EKS

# Optional: List of public subnets (auto-discovered if left empty)
# public_subnet_ids = ["subnet-0a1b2c3d4e5f6g7h8", "subnet-1b2c3d4e5f6g7h8i9"]

# Attach RKE2 Worker EC2 instances (either list instance IDs or specify ASG name)
worker_instance_ids = [
  # "i-0123456789abcdef0",
  # "i-0123456789abcdef1"
]

# worker_asg_name          = "rke2-worker-asg"
# worker_security_group_id = "sg-0123456789abcdef0"

ingress_port        = 80
ingress_protocol    = "HTTP"
health_check_path   = "/healthz"
health_check_port   = "10254" # rke2-ingress-nginx health check port
deregistration_delay = 30

tags = {
  Environment = "Production"
  Cluster     = "RKE2"
  ManagedBy   = "Terraform"
  Project     = "DataRobot-RKE2"
}
